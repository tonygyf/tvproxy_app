<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010"
    android:padding="32dp">

    <!-- Fixed Network Status Banner at the top -->
    <LinearLayout
        android:id="@+id/networkBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp"
        android:weightSum="4">

        <!-- Domestic -->
        <FrameLayout
            android:id="@+id/cardDomestic"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:focusable="true"
            android:clickable="true"
            android:background="#222222"
            android:foreground="@drawable/tv_card_fg"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/ivDomesticFlag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.3"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="国内测试" android:textColor="#FFFFFF" android:textStyle="bold"/>
                <TextView android:id="@+id/tvDomesticIp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#4285F4" android:textSize="16sp" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tvDomesticLoc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Foreign -->
        <FrameLayout
            android:id="@+id/cardForeign"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:focusable="true"
            android:clickable="true"
            android:background="#222222"
            android:foreground="@drawable/tv_card_fg"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/ivForeignFlag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.3"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="国外测试" android:textColor="#FFFFFF" android:textStyle="bold"/>
                <TextView android:id="@+id/tvForeignIp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#4285F4" android:textSize="16sp" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tvForeignLoc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- CF -->
        <FrameLayout
            android:id="@+id/cardCf"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:focusable="true"
            android:clickable="true"
            android:background="#222222"
            android:foreground="@drawable/tv_card_fg"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/ivCfFlag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.3"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CloudFlare" android:textColor="#FFFFFF" android:textStyle="bold"/>
                <TextView android:id="@+id/tvCfIp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#4285F4" android:textSize="16sp" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tvCfLoc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Connectivity -->
        <FrameLayout
            android:id="@+id/cardConn"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:focusable="true"
            android:clickable="true"
            android:background="#222222"
            android:foreground="@drawable/tv_card_fg">

            <ImageView
                android:id="@+id/ivConnFlag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.3"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="墙外测试" android:textColor="#FFFFFF" android:textStyle="bold"/>
                <TextView android:id="@+id/tvConnStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#4285F4" android:textSize="14sp" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tvConnDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/detailBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/tv_detail_banner_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@android:drawable/ic_menu_info_details"
                android:tint="#FFB74D" />

            <TextView
                android:id="@+id/tvDetailBannerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="网站连接详情"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailBannerHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="再次点击顶部卡片可收起"
                android:textColor="#8A8A8A"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/detailBannerScroll"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:descendantFocusability="afterDescendants"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/detailBannerGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:descendantFocusability="afterDescendants"
                android:orientation="horizontal"
                android:useDefaultMargins="false" />
        </ScrollView>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:descendantFocusability="afterDescendants"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/mainContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="afterDescendants"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第一次使用：先在电脑上执行这条命令完成一次性授权"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textGrantCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="#1E1E1E"
                android:fontFamily="monospace"
                android:padding="16dp"
                android:textColor="#7CFC00"
                android:textIsSelectable="true"
                android:textSize="18sp"
                tools:text="adb shell pm grant com.tvip.proxy android.permission.WRITE_SECURE_SETTINGS" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="订阅地址"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editSubUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:hint="粘贴你的订阅链接"
                android:inputType="textUri"
                android:padding="16dp"
                android:background="@drawable/tv_edittext_bg"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnImport"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="导入更新节点"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/tv_button_bg"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="连接"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/tv_button_bg"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="断开"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/tv_button_bg"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="#1E1E1E"
                android:padding="16dp"
                android:text="状态：未启动"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="版本 -"
                android:textColor="#888888"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="节点列表"
                    android:textColor="#AAAAAA"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnRefreshNodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/tv_button_bg"
                    android:text="刷新节点" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nodeListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
